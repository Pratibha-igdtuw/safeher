# SafeHer — environment variables (Tier 3 Part 1: Security Hardening)
#
# Copy this file to `.env` and fill in real values before deploying.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# Core Flask config
# ---------------------------------------------------------------------------
# "production" turns on SESSION_COOKIE_SECURE, HSTS, and force-HTTPS
# (via flask-talisman). Leave as "development" for local http://127.0.0.1
# testing, where secure-only cookies would silently break login.
FLASK_ENV=development

# Used to sign session cookies. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# CORS / WebSocket origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to open a Socket.IO connection.
# Replaces the old cors_allowed_origins="*". Include every origin the
# frontend is actually served from (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ---------------------------------------------------------------------------
# Rate limiting (Flask-Limiter)
# ---------------------------------------------------------------------------
# Storage backend for rate-limit counters. "memory://" is fine for a single
# dev process but does NOT share state across multiple gunicorn/uwsgi
# workers or app instances — point this at Redis in production, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# Optional: only needed if you switch MOCK_MODE = False in utils/alerts.py
# to send real SMS via Twilio.
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
