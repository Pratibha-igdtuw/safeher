# SafeHer — environment variables (Tier 3 Part 1: Security Hardening)
#
# Copy this file to `.env` and fill in real values before deploying.
# Never commit the real `.env` file.

# ---------------------------------------------------------------------------
# Core Flask config
# ---------------------------------------------------------------------------
# "production" turns on SESSION_COOKIE_SECURE, HSTS, and force-HTTPS
# (via flask-talisman). Leave as "development" for local http://127.0.0.1
# testing, where secure-only cookies would silently break login.
FLASK_ENV=development

# Used to sign session cookies. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# CORS / WebSocket origins
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to open a Socket.IO connection.
# Replaces the old cors_allowed_origins="*". Include every origin the
# frontend is actually served from (scheme + host + port).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# ---------------------------------------------------------------------------
# Rate limiting (Flask-Limiter)
# ---------------------------------------------------------------------------
# Storage backend for rate-limit counters. "memory://" is fine for a single
# dev process but does NOT share state across multiple gunicorn/uwsgi
# workers or app instances — point this at Redis in production, e.g.:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# ---------------------------------------------------------------------------
# Optional: only needed if you switch MOCK_MODE = False in utils/alerts.py
# to send real SMS via Twilio.
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Optional: Safety Map v2 (Geoapify search/places, GraphHopper routing)
# ---------------------------------------------------------------------------
# Both are optional. Leaving them unset does NOT break the map — every
# call site falls back to the original free/keyless path (Nominatim for
# search, Overpass for nearby places, OSRM for routing), same as every
# other optional integration in this app.
#
# Get a free key at https://www.geoapify.com/ (3,000 requests/day on the
# free tier). Used server-side for /api/places/* (search/reverse-geocode/
# nearby), and — only if MAP_STYLE_PROVIDER=geoapify below — also embedded
# client-side to load a real MapLibre vector map style. Geoapify's map/
# style keys are designed to be used this way (like a Mapbox/Google Maps
# JS key); restrict it by HTTP referrer in the Geoapify dashboard once you
# have a real domain.
# GEOAPIFY_API_KEY=

# "osm" (default): free raster OpenStreetMap tiles, no key needed.
# "geoapify": real vector rendering via Geoapify's hosted style — needs
# GEOAPIFY_API_KEY set above.
MAP_STYLE_PROVIDER=osm

# Get a free key at https://www.graphhopper.com/ (2,500 requests/day free
# tier). Used for Journey Mode route calculation; falls back to the public
# OSRM demo server automatically if unset.
# GRAPHHOPPER_API_KEY=
